package="tunnel-client"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="clientproxy.io Tunnel"
description="Expose web apps running on your NAS to the internet through a secure clientproxy.io reverse-proxy tunnel. No port forwarding, no public IP, automatic HTTPS. Requires a clientproxy.io account and a tunnel configured in the dashboard."
maintainer="clientproxy.io"
maintainer_url="https://clientproxy.io"
distributor="clientproxy.io"
distributor_url="https://clientproxy.io"
support_url="https://clientproxy.io/docs"
helpurl="https://clientproxy.io/docs"
arch="noarch"
thirdparty="yes"
startable="yes"
ctl_stop="yes"
silent_upgrade="no"
checksum="@CHECKSUM@"
